<Project Sdk="Microsoft.Build.Sql/2.3.0">
  <!--
    SDK-style SQL project: every *.sql under this folder is part of the schema model automatically,
    so adding a table/proc file is enough - no project edit needed. Builds with `dotnet build`
    (no Visual Studio/SSDT required) and produces bin\<Config>\pStudyWare20.DB.dacpac.
    Workflow for schema changes and generating the hand-run SQL script: see README.md.
  -->
  <PropertyGroup>
    <Name>pStudyWare20.DB</Name>
    <ProjectGuid>{dc269b47-54d1-483d-9bb1-3ac183b17bea}</ProjectGuid>
    <DSP>Microsoft.Data.Tools.Schema.Sql.Sql160DatabaseSchemaProvider</DSP>
    <ModelCollation>1033,CI</ModelCollation>
    <DefaultCollation>SQL_Latin1_General_CP1_CI_AS</DefaultCollation>
    <!-- SQL71558: identifier casing differs from its definition (harmless: CI collation).
         SQL71562: usp_pStudyware_Select_StudentLog references the external PranavDB database. -->
    <SuppressTSqlWarnings>71558;71562</SuppressTSqlWarnings>
    <TargetDatabaseSet>True</TargetDatabaseSet>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <TargetFrameworkProfile />
  </PropertyGroup>
  <ItemGroup>
    <!-- Hand-run scripts: visible in the project but never compiled into the schema model. -->
    <Build Remove="ChangeScripts\**" />
    <Build Remove="OnetimeScript\**" />
    <None Include="ChangeScripts\**" />
    <None Include="OnetimeScript\**" />
    <None Include="Tools\**" />
    <None Include="README.md" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="ChangeScripts\" />
    <Folder Include="OnetimeScript\" />
    <Folder Include="Tools\" />
  </ItemGroup>
</Project>